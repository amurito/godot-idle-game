	"panspermia": {
		"cat": "mutaciones",
		"name_es": "Panspermia Negra", "name_en": "Black Panspermia",
		"lore_prefix": "LORE_PANSP",
		"body_es": (
			"Ruta post-Esporulación (requiere Seta Formada). El hongo eyecta esporas hacia el espacio en una secuencia de pulsos controlada. Anti-AFK: no podés ir ni demasiado lento ni demasiado rápido.\n\n"
			+ "[b]Recursos de lanzamiento:[/b]\n"
			+ "• [b]Carga[/b] — necesitás acumular 100 para alcanzar la velocidad de escape. Decae 7/s (no podés pausar).\n"
			+ "• [b]Calor[/b] — cada eyección suma 25. Disipa 15/s. Si una eyección pasaría de 100 → MISFIRE.\n\n"
			+ "[b]Por cada eyección (click):[/b]\n"
			+ "• +15 carga · +25 calor · −$12.000 · +0.05 ε (estrés del lanzamiento)\n\n"
			+ "[b]Misfire (sobrecarga):[/b]\n"
			+ "• Pierdes 18 de carga. Máx 5 misfires antes de abortar el lanzamiento → Esporulación base sin bonus.\n\n"
			+ "[b]Ritmo óptimo:[/b] eyección → pequeña pausa → eyección. Demasiado rápido → misfire. Demasiado lento → la carga decae y nunca llegás a 100.\n\n"
			+ "[b]Éxito:[/b] Carga ≥ 100 → [b]PANSPERMIA NEGRA[/b] (+10 PL). Requiere Seta Formada para el bonus ×3 de esporas."
		),
		"body_en": (
			"Post-Sporulation route (requires Formed Mushroom). The fungus ejects spores into space in a controlled pulse sequence. Anti-AFK: you can't go too slow or too fast.\n\n"
			+ "[b]Launch resources:[/b]\n"
			+ "• [b]Charge[/b] — you need to accumulate 100 to reach escape velocity. Decays 7/s (you can't pause).\n"
			+ "• [b]Heat[/b] — each ejection adds 25. Dissipates 15/s. If an ejection would exceed 100 → MISFIRE.\n\n"
			+ "[b]Per ejection (click):[/b]\n"
			+ "• +15 charge · +25 heat · −$12,000 · +0.05 ε (launch stress)\n\n"
			+ "[b]Misfire (overload):[/b]\n"
			+ "• Lose 18 charge. Max 5 misfires before the launch aborts → base Sporulation with no bonus.\n\n"
			+ "[b]Optimal rhythm:[/b] eject → short pause → eject. Too fast → misfire. Too slow → charge decays and you never reach 100.\n\n"
			+ "[b]Success:[/b] Charge ≥ 100 → [b]BLACK PANSPERMIA[/b] (+10 LP). Requires Formed Mushroom for the ×3 spore bonus."
		),
		"unlock": {"type": "route_closed", "route": "PANSPERMIA NEGRA"},
		"see_also": ["primordio_mecanica", "esporulacion", "colonizacion_mecanica"],
	},
