	"reencarnacion": {
		"cat": "rutas",
		"name_es": "Reencarnación Heredada", "name_en": "Inherited Reincarnation",
		"body_es": (
			"Ruta post-trascendencia. Empezás con todos los upgrades al nivel del ciclo anterior, pero cada compra futura escala ×1.5 más caro (deuda kármica).\n\n"
			+ "[i]Arrancás fortísimo, pero el techo llega antes: el crecimiento se ahoga en su propia herencia.[/i]"
		),
		"body_en": (
			"Post-transcendence route. You start with all upgrades at the previous cycle's level, but every future purchase scales ×1.5 more expensive (karmic debt).\n\n"
			+ "[i]You start extremely strong, but the ceiling comes sooner: growth drowns in its own inheritance.[/i]"
		),
		"unlock": {"type": "transcendence_count", "min": 1},
		"see_also": ["post_tras_routes"],
